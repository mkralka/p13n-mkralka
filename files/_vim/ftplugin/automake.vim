" Configuration specific to Automake files

setlocal   autoindent
setlocal   expandtab
setlocal   fileformat=unix
setlocal   foldmethod=indent
setlocal   formatoptions+=c	" Comments are subject to hard wrapping
setlocal   formatoptions-=t	" Text (non-comments) are exempt from hard wrapping
setlocal   shiftwidth=4
setlocal nosmartindent
setlocal   softtabstop=4
setlocal   tabstop=8
setlocal   textwidth=79
